# PostgreSQL is the production/default database. For a local smoke test:
# DATABASE_URL=sqlite:///./data/impactai.db
DATABASE_URL=postgresql+psycopg://impactai:impactai@localhost:5432/impactai
DATA_DIR=data/source
ARTIFACT_DIR=ml/artifacts
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Used only by the Next.js server proxy; never sent to the browser.
BACKEND_URL=http://127.0.0.1:8000
# Optional server-side explanation provider; no paid API is required.
COACH_LLM_URL=
COACH_LLM_API_KEY=
COACH_LLM_MODEL=

# Optional saved research comparisons; absent files leave ranges unavailable.
PEER_INTERVAL_DIR=data/research/peer-intervals-20261017
